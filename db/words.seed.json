<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>VẼ ĐI!</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;800;900&display=swap">
<style>
:root{--bg:#E3F2FF;--card:#fff;--ink:#14233B;--mute:#41536E;--red:#D9480F;--yel:#FFD166;--teal:#0B6E99;--onred:#fff;--onteal:#fff}
@media(prefers-color-scheme:dark){:root{--bg:#0F1A2B;--card:#1A2740;--ink:#EAF2FF;--mute:#B7C6DB;--red:#FF8A57;--teal:#5CC8F2;--onred:#1A0F08;--onteal:#0B1220}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:'Be Vietnam Pro',system-ui,sans-serif}
button,input,select{font:inherit;color:inherit}button{cursor:pointer}[hidden]{display:none!important}
.card{background:var(--card);border:3px solid var(--ink);border-radius:16px;box-shadow:4px 4px 0 var(--ink);padding:14px}
.btn{min-height:46px;padding:0 18px;border:3px solid var(--ink);border-radius:12px;font-weight:800;background:var(--card)}
.red{background:var(--red);color:var(--onred)}.yel{background:var(--yel);color:#1F2430}
input[type=text],input[type=password],input[type=number]{min-height:46px;width:100%;border:3px solid var(--ink);border-radius:12px;padding:0 12px;background:var(--card)}
:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
.wrap{max-width:1100px;margin:0 auto;padding:20px}.logo{font-family:'Be Vietnam Pro',system-ui,'Segoe UI',Arial,sans-serif;font-weight:900;letter-spacing:1px;color:var(--red);margin:0;line-height:1.1}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:16px}.stack{display:grid;gap:10px}
.chips{display:flex;flex-wrap:wrap;gap:8px}.chip{min-height:40px;padding:0 14px;border-radius:99px;border:3px solid var(--ink);background:var(--card);font-weight:600}
.chip[aria-pressed=true]{background:var(--teal);color:var(--onteal)}.mute{color:var(--mute)}
.item{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px;border:2px solid var(--ink);border-radius:12px}
.grid{display:grid;grid-template-columns:220px 1fr 280px;gap:14px;margin-top:14px}
@media(max-width:860px){.cols,.grid{grid-template-columns:1fr}}
.row{display:flex;justify-content:space-between;padding:6px 10px;border-radius:10px}.row.on{background:var(--yel);color:#1F2430}.row.ok{color:var(--teal);font-weight:800}
#cv{width:100%;aspect-ratio:4/3;background:#fff;border:3px solid var(--ink);border-radius:16px;touch-action:none;display:block}
.hint{font-size:clamp(20px,4vw,32px);font-weight:800;letter-spacing:6px;text-align:center}
.timer{width:64px;height:64px;border-radius:50%;background:var(--yel);color:#1F2430;border:3px solid var(--ink);display:grid;place-items:center;font-size:24px;font-weight:800}
.sw{width:44px;height:44px;border-radius:50%;border:3px solid var(--ink)}.sw[aria-pressed=true]{outline:4px solid var(--teal);outline-offset:2px}
#log{height:280px;overflow:auto;display:grid;gap:5px;align-content:start;font-size:15px;margin:8px 0}.sys{color:var(--teal);font-weight:800}.priv{opacity:.7}
</style></head><body><main class="wrap">

<section id="home">
<h1 class="logo" style="font-size:clamp(60px,12vw,110px)">VẼ ĐI!</h1>
<div class="cols" style="margin-top:12px">
<div class="card stack">
<label for="nick" style="font-weight:800">Biệt danh</label><input type="text" id="nick" maxlength="16" value="Bạn Mèo Béo">
<button class="btn red" id="quick" style="min-height:54px;font-size:19px">Chơi ngay</button>
<div style="display:flex;gap:8px"><input type="text" id="code" placeholder="Mã phòng" aria-label="Mã phòng"><button class="btn yel" id="joinCode">Vào</button></div>
<input type="password" id="joinPass" placeholder="Mật khẩu phòng (nếu có)" aria-label="Mật khẩu phòng" hidden>
<b style="margin-top:8px">Tạo phòng</b>
<input type="text" id="rname" placeholder="Tên phòng" aria-label="Tên phòng" maxlength="24">
<div class="chips" id="kinds" role="group" aria-label="Kho từ"></div>
<div style="display:flex;gap:8px"><label class="mute" style="flex:1">Giây/lượt<input type="number" id="rtime" value="60" min="30" max="180"></label><label class="mute" style="flex:1">Điểm thắng<input type="number" id="rgoal" value="300" min="100" max="2000"></label></div>
<input type="password" id="rpass" placeholder="Mật khẩu (tuỳ chọn)" aria-label="Mật khẩu tạo phòng">
<label><input type="checkbox" id="rpub" checked> Hiện trong danh sách phòng công khai</label>
<button class="btn yel" id="create">Tạo phòng</button>
<p id="err" class="mute" role="alert" style="margin:0"></p>
</div>
<div class="card stack"><b>Phòng đang mở</b><div id="rooms" class="stack"></div>
<hr><b>Đóng góp từ mới</b>
<input type="text" id="wtext" placeholder="Một từ, thành ngữ, tục ngữ…" aria-label="Từ đóng góp" maxlength="80">
<select id="wkind" class="btn" aria-label="Loại từ"></select>
<button class="btn" id="wsend">Gửi duyệt</button></div>
</div></section>

<section id="game" hidden>
<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
<span class="logo" style="font-size:30px">VẼ ĐI!</span>
<div style="text-align:center"><div class="mute" id="info" style="font-size:14px"></div><div class="hint" id="hint" aria-live="polite"></div></div>
<div class="timer" id="time" role="timer">0</div></div>
<div class="grid">
<div class="card"><b>Bảng điểm</b><div id="score" style="margin-top:8px"></div>
<button class="btn yel" id="invite" style="margin-top:12px;width:100%">Sao chép link mời</button>
<button class="btn" id="leave" style="margin-top:8px;width:100%">Rời phòng</button></div>
<div>
<div class="card" id="pick" hidden style="margin-bottom:10px"><b>Chọn một từ để vẽ</b><div id="opts" class="stack" style="margin-top:8px"></div></div>
<canvas id="cv" width="800" height="600" aria-label="Khung vẽ"></canvas>
<div id="tools" class="chips" style="margin-top:10px;align-items:center" hidden>
<button class="sw" data-c="#C8321F" style="background:#C8321F" aria-label="Đỏ"></button><button class="sw" data-c="#0F5F58" style="background:#0F5F58" aria-label="Xanh"></button>
<button class="sw" data-c="#FFC93C" style="background:#FFC93C" aria-label="Vàng"></button><button class="sw" data-c="#1F2430" style="background:#1F2430" aria-label="Đen"></button>
<button class="btn" id="eraser" aria-pressed="false">Tẩy</button><button class="btn" id="clear">Xóa hết</button></div></div>
<div class="card"><b>Đoán chữ</b><div id="log" aria-live="polite"></div>
<label for="guess" class="mute" style="font-size:14px">Nhập đáp án</label><input type="text" id="guess" autocomplete="off" maxlength="60"></div>
</div></section>
</main>
<script src="/socket.io/socket.io.js"></script>
<script>
const socket=io(),$=id=>document.getElementById(id);
const KINDS=['Từ đơn','Từ ghép','Thành ngữ','Tục ngữ','Ca dao'];let kinds=new Set(['Từ ghép','Thành ngữ']);
let st=null,roomCode=null;
const el=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e};
const nick=()=>$('nick').value.trim()||'Khách';
function drawKinds(){const b=$('kinds');b.textContent='';KINDS.forEach(k=>{const c=el('button','chip',k);c.setAttribute('aria-pressed',kinds.has(k));c.onclick=()=>{kinds.has(k)?kinds.delete(k):kinds.add(k);if(!kinds.size)kinds.add(k);drawKinds()};b.appendChild(c)})}
drawKinds();KINDS.forEach(k=>$('wkind').appendChild(new Option(k,k)));
function entered(r){if(!r.ok){$('err').textContent=r.error||'Không vào được phòng';if(r.needPass)$('joinPass').hidden=false;return}
  roomCode=r.code;history.replaceState(null,'','?r='+r.code);$('home').hidden=true;$('game').hidden=false;$('log').textContent='';clearCv()}
$('quick').onclick=()=>socket.emit('room:quick',{nick:nick()},entered);
$('joinCode').onclick=()=>socket.emit('room:join',{code:$('code').value.trim(),password:$('joinPass').value,nick:nick()},entered);
$('create').onclick=()=>socket.emit('room:create',{nick:nick(),name:$('rname').value,kinds:[...kinds],time:$('rtime').value,goal:$('rgoal').value,password:$('rpass').value,isPublic:$('rpub').checked},entered);
$('leave').onclick=()=>{socket.emit('room:leave');$('game').hidden=true;$('home').hidden=false;history.replaceState(null,'','/');st=null;listRooms()};
$('invite').onclick=()=>navigator.clipboard.writeText(location.origin+'/?r='+roomCode).then(()=>$('invite').textContent='Đã sao chép!',()=>{});
$('wsend').onclick=()=>socket.emit('word:submit',{text:$('wtext').value,kind:$('wkind').value},r=>{$('err').textContent=r.ok?'Đã gửi, chờ kiểm duyệt. Cảm ơn bạn!':r.error;if(r.ok)$('wtext').value=''});
function listRooms(){socket.emit('lobby:list',L=>{const b=$('rooms');b.textContent='';if(!L.length)b.appendChild(el('p','mute','Chưa có phòng nào. Hãy tạo phòng đầu tiên!'));
  L.forEach(r=>{const i=el('div','item'),d=el('div');d.append(el('b',null,r.name+(r.locked?' (khóa)':'')),el('div','mute',r.kinds.join(', ')+' · '+r.players+'/'+r.max+' · '+r.goal+' điểm'));
  const j=el('button','btn yel','Vào');j.onclick=()=>{$('code').value=r.code;$('joinCode').click()};i.append(d,j);b.appendChild(i)})})}
setInterval(()=>{if(!$('home').hidden)listRooms()},5000);socket.on('connect',listRooms);
const q=new URLSearchParams(location.search).get('r');if(q)$('code').value=q;

socket.on('room:state',s=>{st=s;const me=socket.id,drawer=s.drawer===me;
  $('score').textContent='';[...s.players].sort((a,b)=>b.score-a.score).forEach(p=>{const r=el('div','row'+(p.id===s.drawer?' on':p.solved?' ok':''));
    r.append(el('span',null,p.nick+(p.id===me?' (bạn)':'')+(p.id===s.drawer?' (đang vẽ)':'')),el('b',null,p.score));$('score').appendChild(r)});
  $('info').textContent=s.phase==='lobby'?'Đang chờ thêm người chơi… Mã phòng: '+s.code:s.name+' · Lượt '+s.turn+' · Đạt '+s.goal+' điểm';
  $('hint').textContent=s.word?s.word:s.hint.join(' ');
  $('time').textContent=s.phase==='drawing'?s.left:'-';
  $('tools').hidden=!(drawer&&s.phase==='drawing');
  $('pick').hidden=!(drawer&&s.phase==='choosing');
  $('guess').disabled=drawer&&s.phase==='drawing';
  if(s.phase==='choosing'&&!drawer)$('hint').textContent='Đang chọn từ…'});
socket.on('tick',t=>$('time').textContent=t);
socket.on('game:choices',c=>{const b=$('opts');b.textContent='';c.forEach(o=>{const x=el('button','btn',o.text);x.style.textAlign='left';x.appendChild(el('div','mute',o.kind));x.onclick=()=>{socket.emit('game:pick',o.text);$('pick').hidden=true};b.appendChild(x)});$('pick').hidden=false});
socket.on('chat:msg',m=>{const d=el('div',m.sys?'sys':m.priv?'priv':'');if(m.nick)d.appendChild(el('b',null,m.nick+': '));d.appendChild(document.createTextNode(m.text));$('log').appendChild(d);$('log').scrollTop=1e9});
socket.on('turn:end',m=>addSys('Đáp án: '+m.word));
socket.on('game:over',L=>addSys('Kết thúc! Hạng nhất: '+L[0].nick+' ('+L[0].score+' điểm). Ván mới sau 10 giây.'));
function addSys(t){const d=el('div','sys',t);$('log').appendChild(d);$('log').scrollTop=1e9}
$('guess').addEventListener('keydown',e=>{if(e.key==='Enter'&&$('guess').value.trim()){socket.emit('chat:guess',$('guess').value);$('guess').value=''}});

// ---- Khung vẽ: toạ độ chuẩn hoá 0..1 để mọi kích thước màn hình đều khớp ----
const cv=$('cv'),ctx=cv.getContext('2d');let col='#C8321F',erase=false,down=false,last=null;
function clearCv(){ctx.fillStyle='#fff';ctx.fillRect(0,0,800,600)}
function seg(g){ctx.strokeStyle=g.c;ctx.lineWidth=g.w;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(g.x0*800,g.y0*600);ctx.lineTo(g.x1*800,g.y1*600);ctx.stroke()}
function pos(e){const r=cv.getBoundingClientRect();return{x:Math.min(1,Math.max(0,(e.clientX-r.left)/r.width)),y:Math.min(1,Math.max(0,(e.clientY-r.top)/r.height))}}
const canDraw=()=>st&&st.phase==='drawing'&&st.drawer===socket.id;
cv.addEventListener('pointerdown',e=>{if(!canDraw())return;down=true;last=pos(e);cv.setPointerCapture(e.pointerId);emit(last,last)});
cv.addEventListener('pointermove',e=>{if(!down)return;const p=pos(e);emit(last,p);last=p});
['pointerup','pointercancel'].forEach(t=>cv.addEventListener(t,()=>down=false));
function emit(a,b){const g={x0:a.x,y0:a.y,x1:b.x,y1:b.y,c:erase?'#ffffff':col,w:erase?28:8};seg(g);socket.emit('draw:stroke',g)}
socket.on('draw:stroke',seg);socket.on('draw:clear',clearCv);socket.on('draw:history',h=>{clearCv();h.forEach(seg)});
document.querySelectorAll('.sw').forEach(b=>b.onclick=()=>{col=b.dataset.c;erase=false;$('eraser').setAttribute('aria-pressed','false');document.querySelectorAll('.sw').forEach(x=>x.setAttribute('aria-pressed',x===b))});
$('eraser').onclick=()=>{erase=!erase;$('eraser').setAttribute('aria-pressed',erase)};
$('clear').onclick=()=>{if(canDraw())socket.emit('draw:clear')};
clearCv();
</script></body></html>
